{
  "name": "@lumine-code/watcher",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": "https://github.com/lumine-code/watcher",
  "description": "Observes directory changes through native filesystem backends.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wrapper.js",
    "README.md",
    "LICENSE",
    "src",
    "binding.gyp"
  ],
  "scripts": {
    "build": "node-gyp rebuild",
    "install": "node-gyp rebuild",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node scripts/benchmark.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "filesystem",
    "watcher",
    "inotify",
    "fsevents",
    "notifications"
  ]
}
