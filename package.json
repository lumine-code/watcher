{
  "name": "@lumine-code/watcher",
  "author": "lumine-code",
  "version": "2.6.1",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumine-code/watcher.git"
  },
  "description": "Watches directories and queries filesystem events from native code.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.js.flow",
    "index.d.ts",
    "wrapper.js",
    "package.json",
    "README.md",
    "LICENSE",
    "src",
    "scripts/build-from-source.js",
    "binding.gyp"
  ],
  "scripts": {
    "prebuild": "prebuildify --napi --strip --tag-libc",
    "format": "prettier --write \"./**/*.{js,mjs,json,md,ts,flow}\"",
    "build": "node-gyp rebuild",
    "install": "node-gyp rebuild",
    "test": "mocha"
  },
  "engines": {
    "node": ">= 10.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,mjs,json,md,ts,flow}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "detect-libc": "^2.0.3",
    "is-glob": "^4.0.3",
    "node-addon-api": "^7.0.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.19.8",
    "fs-extra": "^10.0.0",
    "husky": "^7.0.2",
    "lint-staged": "^11.1.2",
    "mocha": "^9.1.1",
    "napi-wasm": "^1.1.0",
    "prebuildify": "^6.0.1",
    "prettier": "^2.3.2"
  },
  "binary": {
    "napi_versions": [
      3
    ]
  }
}
